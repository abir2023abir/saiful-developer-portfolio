# Copy to .env.local and fill in. Never commit .env.local.

# --- Admin panel -----------------------------------------------------------
# Generate the hash with:  node scripts/hash-password.js "your password"
ADMIN_USER=abir
ADMIN_PASSWORD_HASH=<salt>:<scrypt-hash>
# Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=<32+ random characters>

# --- Content storage -------------------------------------------------------
# "fs" (default) writes into ./content and ./public/projects — fine locally and
# on a VPS. Serverless hosts have a read-only filesystem, so use "blob" there.
STORAGE=fs
# BLOB_READ_WRITE_TOKEN=<from the Vercel Blob store>

# --- Site ------------------------------------------------------------------
# Canonical origin, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Contact form (optional) ----------------------------------------------
# Messages always land in the admin panel. Set these to also forward by email.
# RESEND_API_KEY=
# CONTACT_TO=saifultwilight20@gmail.com
# CONTACT_FROM=Portfolio <onboarding@resend.dev>
